# ShieldOps Configuration
# Copy to .env and fill in your values

# === Devin API ===
DEVIN_API_KEY=cog_your_key_here
DEVIN_ORG_ID=your_org_id

# === GitHub ===
GITHUB_TOKEN=ghp_your_token_here
GITHUB_REPO_OWNER=gaurav21
GITHUB_REPO_NAME=superset
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# === Datadog ===
DD_API_KEY=your_dd_api_key
DD_APP_KEY=your_dd_app_key
DD_SITE=datadoghq.com

# === Scanner ===
SCAN_SCHEDULE_CRON=0 2 * * *  # 2 AM daily
SCAN_TYPES=pip-audit,npm-audit,trivy,semgrep

# === Orchestrator ===
SHIELDOPS_PORT=8000
SHIELDOPS_LOG_LEVEL=INFO
MAX_CONCURRENT_DEVIN_SESSIONS=3
DEVIN_SESSION_TIMEOUT=3600  # 1 hour max per session

# === Event-Driven Trigger (trigger.py) ===
TRIGGER_LABEL=shieldops              # GitHub label that triggers remediation
POLL_INTERVAL_SECONDS=15             # How often to poll Devin for status
SESSION_TIMEOUT_SECONDS=3600         # Max time before giving up on a session
MAX_CONCURRENT_SESSIONS=3            # Semaphore limit for parallel Devin sessions
SKIP_SIGNATURE_CHECK=0               # Set to 1 for local replay testing (disables HMAC)

# === API Authentication ===
# Set this to require an X-API-Key header on sensitive endpoints (/status, /scan, /metrics, /setup/datadog).
# Leave empty to skip auth (development only).
SHIELDOPS_API_KEY=

# === CORS ===
# Comma-separated list of allowed origins. Leave empty to block all cross-origin requests.
CORS_ALLOWED_ORIGINS=
