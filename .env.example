# ShieldOps Configuration
# Copy to .env and fill in your values

# === Devin API ===
DEVIN_API_KEY=cog_your_key_here
DEVIN_ORG_ID=your_org_id

# === GitHub ===
GITHUB_TOKEN=ghp_your_token_here
GITHUB_REPO_OWNER=gsharma21
GITHUB_REPO_NAME=superset
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# === Datadog ===
DD_API_KEY=your_dd_api_key
DD_APP_KEY=your_dd_app_key
DD_SITE=datadoghq.com

# === Scanner ===
SCAN_SCHEDULE_CRON=0 2 * * *  # 2 AM daily
SCAN_TYPES=pip-audit,npm-audit,trivy,semgrep

# === Orchestrator ===
SHIELDOPS_PORT=8000
SHIELDOPS_LOG_LEVEL=INFO
MAX_CONCURRENT_DEVIN_SESSIONS=3
DEVIN_SESSION_TIMEOUT=3600  # 1 hour max per session
